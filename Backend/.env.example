# --- Database ---
# Paste your Supabase connection string here (Project Settings > Database > Connection string > URI)
# Example: postgresql://postgres.[project-ref]:[password]@aws-0-[region].pooler.supabase.com:6543/postgres
# SERVER-ONLY: never ship this to the browser / dashboard build.
DATABASE_URL="postgresql://user:password@localhost:5432/aamako_agro"
# Direct (non-pooled) connection for Prisma Migrate / `db push`.
# Local dev: same database as above. Supabase prod: port-5432 direct URL
# (DATABASE_URL there points at the 6543 pooler). Required — schema.prisma
# reads it via `directUrl = env("DIRECT_URL")`.
DIRECT_URL="postgresql://user:password@localhost:5432/aamako_agro"

# --- Auth ---
# SERVER-ONLY secrets: never expose to the browser or any NEXT_PUBLIC_* build var.
# Generate strong values in production:  openssl rand -hex 32
JWT_ACCESS_SECRET="change-me-access-secret-min-32-chars-long!!"
JWT_REFRESH_SECRET="change-me-refresh-secret-min-32-chars!"
JWT_ACCESS_EXPIRES="15m"
JWT_REFRESH_EXPIRES_DAYS=30

# --- Google Sign-In (storefront "Continue with Google") ---
# OAuth 2.0 Web client ID from https://console.cloud.google.com/apis/credentials
# (Authorized JavaScript origins must include the storefront origin, e.g. http://localhost:8080).
# Leave empty to disable Google sign-in — the storefront button will show a setup notice.
# PUBLIC/SAFE: client IDs are embedded in every OAuth client by design.
GOOGLE_CLIENT_ID=""

# --- App ---
PORT=3000
# Set to "production" on Render/Vercel so trust-proxy + HSTS behave correctly.
NODE_ENV=development

# --- CORS: comma-separated list of allowed frontend origins ---
# SERVER-ONLY allow-list — never a wildcard. In production include ONLY the real
# storefront + dashboard origins (e.g. https://aamakoagro.com, https://admin.aamakoagro.com).
# No value => cross-origin browser requests are rejected (safe default).
CORS_ORIGINS=http://127.0.0.1:4000,http://localhost:4000,http://localhost:5173,http://localhost:8080,http://127.0.0.1:8080,http://127.0.0.1:3001,http://localhost:3001

# --- Public base URL the API advertises for uploaded media ---
# e.g. https://api.aamakoagro.com/api so stored image URLs are absolute and reachable.
# Omit to fall back to http://localhost:<PORT>/api (dev only).
PUBLIC_API_URL="http://localhost:3000/api"

# --- Password reset (storefront-only forgot-password / reset-password) ---
# Reset links emailed to users always point at the storefront reset page:
#   ${FRONTEND_URL}/reset-password?token=…
# Point FRONTEND_URL at the real storefront URL in production. In local dev
# the default (http://localhost:8080) applies.
FRONTEND_URL="http://localhost:8080"
# How long a reset link stays valid (minutes). 30 is a good default.
PASSWORD_RESET_TTL_MINUTES=30

# --- Email via Resend (storefront password reset) ---
# Without RESEND_API_KEY the API uses the `log` provider: in development the
# reset URL is printed to the server console so the full flow works with ZERO
# setup. In production the token is redacted from logs and a CRITICAL warning
# is logged instead (emails NOT delivered).
#
# To send REAL email via Resend, ONLY set these env vars (no code changes):
#
#   1. API key from https://resend.com/api-keys
RESEND_API_KEY=""
#   2. Verified sender address — MUST be a domain verified at
#      https://resend.com/domains, e.g. "no-reply@aamakoagro.com".
#      (For smoke tests only you may use "onboarding@resend.dev".)
RESEND_FROM_EMAIL=""
#   3. Optional display name shown as the sender ("Aama ko Agro <addr>").
RESEND_FROM_NAME="Aama ko Agro"
#   4. Optional Reply-To shown to recipients.
EMAIL_REPLY_TO=""
# When RESEND_API_KEY is set, the API logs `[email] provider=resend` at boot
# and delivers via https://api.resend.com/emails. When unset it logs
# `[email] provider=log` and writes emails to stdout instead.
