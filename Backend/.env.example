# --- Database ---
# Paste your Supabase connection string here (Project Settings > Database > Connection string > URI)
# Example: postgresql://postgres.[project-ref]:[password]@aws-0-[region].pooler.supabase.com:6543/postgres
DATABASE_URL="postgresql://user:password@localhost:5432/aamako_agro"

# --- Auth ---
JWT_ACCESS_SECRET="change-me-access-secret-min-32-chars-long!!"
JWT_REFRESH_SECRET="change-me-refresh-secret-min-32-chars!"
JWT_ACCESS_EXPIRES="15m"
JWT_REFRESH_EXPIRES_DAYS=30

# --- App ---
PORT=3000
NODE_ENV=development

# --- CORS: comma-separated list of allowed frontend origins ---
CORS_ORIGINS=http://127.0.0.1:4000,http://localhost:4000,http://localhost:5173,http://localhost:8080
