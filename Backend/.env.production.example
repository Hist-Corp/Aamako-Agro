# ── Production environment for Render + Supabase ────────────────────────────
# Copy → .env and fill in values from the Supabase & Render dashboards.
# NEVER commit the real .env — it contains secrets.

# ── Resend / email deliverability (do this FIRST so reset emails arrive) ───
# 1. https://resend.com/domains → Add Domain → enter your apex or subdomain
#    (e.g. `aamakoagro.com` or `mail.aamakoagro.com`). Resend shows 3 DNS
#    records (SPF + 2× DKIM) — add all three at your DNS host (Vercel /
#    Cloudflare / Route53), then wait for "Verified".
# 2. https://resend.com/api-keys → Create API Key (Sending access) → copy `re_…`
# 3. Set in Render Dashboard → Service → Environment (DO NOT commit):
#      RESEND_API_KEY="re_..."                                   ← the key
#      RESEND_FROM_EMAIL="no-reply@aamakoagro.com"               ← address on the VERIFIED domain
#      RESEND_FROM_NAME="Aama ko Agro"                           ← display name (optional)
#      EMAIL_REPLY_TO="support@aamakoagro.com"                   ← where replies go (optional)
# 4. Redeploy. Boot logs `[email] provider=resend` = live. `[email]
#    provider=log` = key missing → reset URLs only go to server logs.
# 5. Test: POST /api/auth/forgot-password with a real address, click the link.
# NOTE: RESEND_FROM_EMAIL's domain MUST be the verified one — a mismatch is the #1
# cause of silent delivery failure (Resend accepts the API call, mailbox
# drops it). Keep onboarding@resend.dev for smoke tests ONLY (it sends to
# your Resend account email only).

# ── Database (Supabase pooled Transaction connection, port 6543) ─────────────
# From Supabase Dashboard → Project Settings → Database → Connection string
# Use the "Transaction" / pooled URL with pgbouncer=true for serverless/Render:
#   DATABASE_URL="postgresql://postgres.<ref>:<password>@aws-0-<region>.pooler.supabase.com:6543/postgres?pgbouncer=true"
#
# IMPORTANT — Supabase IP allow-list:
#   If your Supabase project has IP restrictions enabled, add Render's
#   egress IP addresses (found in Render Dashboard → Service → Environment)
#   to the allow-list. Alternatively use the pooler which is reachable
#   from any origin.
# Runtime uses the POOLER URL (port 6543, pgbouncer=true) for serverless safety.
DATABASE_URL="postgresql://postgres.<project-ref>:<password>@aws-0-<region>.pooler.supabase.com:6543/postgres?pgbouncer=true"

# Direct (non-pooled) connection (port 5432) — required for `prisma migrate deploy`.
# From Supabase Dashboard → Database → Connection string → "Session" string.
#   Or construct from the direct host: db.<region>.supabase.co:5432
DIRECT_URL="postgresql://postgres.<project-ref>:<password>@db.<region>.supabase.co:5432/postgres"

# ── Auth secrets — MUST be random 32+ char hex strings ────────────────────────
# Generate with:  openssl rand -hex 32
JWT_ACCESS_SECRET="<32+ random hex chars>"
JWT_REFRESH_SECRET="<32+ random hex chars>"
JWT_ACCESS_EXPIRES="15m"
JWT_REFRESH_EXPIRES_DAYS="30"

# ── Google Sign-In (storefront "Continue with Google") ──────────────────────
# OAuth 2.0 Web client ID from https://console.cloud.google.com/apis/credentials
# Leave empty to disable Google sign-in.
# Required authorized JS origins: your Vercel storefront URL (e.g. https://aamako-agro.vercel.app)
GOOGLE_CLIENT_ID=""

# ── App ──────────────────────────────────────────────────────────────────────
PORT=10000   # Render assigns the port via $PORT at runtime; this is the default
NODE_ENV=production

# ── CORS: comma-separated list of allowed frontend origins ────────────────────
# With the Vercel /api proxy rewrite, the storefront and dashboard are same-origin
# and CORS is not exercised. Set this to your real Vercel app URLs so that any
# direct browser-to-Render calls also work.
# Example: CORS_ORIGINS=https://aamako-agro.vercel.app,https://aamako-dashboard.vercel.app
CORS_ORIGINS="https://aamako-agro.vercel.app,https://aamako-dashboard.vercel.app"

# ── Public API URL (for absolute URLs in emails / media) ─────────────────────
# Set to your Render service URL. Omit for localhost dev default.
PUBLIC_API_URL="https://<your-render-api>.onrender.com/api"

# ── Password reset (storefront-only forgot-password / reset-password) ──────
# Reset links emailed to users always point at the storefront reset page:
#   ${FRONTEND_URL}/reset-password?token=…
# Point FRONTEND_URL at the real storefront URL in production.
FRONTEND_URL="https://<your-storefront>.vercel.app"
PASSWORD_RESET_TTL_MINUTES="30"

# ── Email via Resend (OPTIONAL — env-only enablement) ───────────────────────
# Leave RESEND_API_KEY empty to keep the `log` provider (reset tokens are
# redacted from production logs and a CRITICAL warning is logged). To send
# REAL email:
#   1. API key from https://resend.com/api-keys
RESEND_API_KEY=""
#   2. Verified sender address — a domain verified at https://resend.com/domains
RESEND_FROM_EMAIL="no-reply@aamakoagro.com"
#   3. Optional display name
RESEND_FROM_NAME="Aama ko Agro"
#   4. Optional Reply-To
EMAIL_REPLY_TO="support@aamakoagro.com"