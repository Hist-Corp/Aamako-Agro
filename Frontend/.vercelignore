# --- Dev-only server (Vercel serves static files directly) ---
# Keep this file named `dev-server.js`: a root-level `server.js` makes Vercel's
# zero-config detection classify the project as a Node backend (it expects a
# serverless entrypoint via package.json#main) instead of a static site.
dev-server.js
static-response.js

# --- Alternative dev servers / scripts ---
serve.py
serve3.py
daemon-serve.py
start-server.sh

# --- Local dev logs ---
*.log
_store.log
_store_err.log
fe.log
fe_install.log

# --- Dependencies / build artifacts ---
node_modules/
package-lock.json
# No npm dependencies exist, but this repo DOES have a package.json (for local
# dev scripts only). If Vercel sees a package.json it can auto-detect the
# "Node" application preset and run the Node *backend* builder, which then
# fails with `No entrypoint found in "/vercel/path0/Frontend"` because it looks
# for a server file (app.js / index.js / server.js / main.js / src/*) and
# `server.js` above is deliberately excluded. Hiding the manifest keeps the
# deployment unambiguously static. Local dev is unaffected: .vercelignore only
# changes what Vercel uploads, so `npm --prefix Frontend run start` still works.
package.json

# --- Test files ---
tests/

# --- Docker (Vercel doesn't need these) ---
Dockerfile
.dockerignore

# --- Env files ---
.env
.env.*