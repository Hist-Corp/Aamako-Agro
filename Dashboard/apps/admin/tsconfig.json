{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "paths": {
      "@/*": ["./src/*"],
      "@aamako/shared-types": ["../../packages/shared-types/src"]
    },
    "plugins": [
      {
        "name": "next"
