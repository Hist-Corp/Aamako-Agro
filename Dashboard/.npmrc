# pnpm's default isolated linker installs dependencies as symlinks into
# Dashboard/node_modules/.pnpm. Vercel's packager rejects that layout for this
# app ("The framework produced an invalid deployment package for a Serverless
# Function … files in symlinked directories"), and forcing the files into the
# trace from either the junction path or the .pnpm store path fails too (see
# DEPLOYMENT.md §9). hoisted gives a flat, real-directory node_modules like npm,
# so the serverless function bundles are self-contained and symlink-free.
# Requires a re-run of `pnpm install` after this file changes.
node-linker=hoisted
